# Frontend image: Next.js standalone output, unprivileged user, no dev dependencies.
FROM node:22-bookworm-slim@sha256:be979e5523c76fa4d5ca4ebd3099078f220aa47ec39c48ad5b5df9314debd6eb AS build
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json frontend/.npmrc ./
RUN npm ci --ignore-scripts --no-audit
COPY frontend/ ./
ARG NEXT_PUBLIC_APP_NAME=ProjectFlow
ENV NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME
RUN npm run build


# Runtime: distroless Node (no shell, no package manager, no npm), unprivileged.
FROM gcr.io/distroless/nodejs22-debian12:nonroot@sha256:13593b7570658e8477de39e2f4a1dd25db2f836d68a0ba771251572d23bb4f8e
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
WORKDIR /srv
COPY --from=build --chown=root:root /build/.next/standalone ./
COPY --from=build --chown=root:root /build/.next/static ./.next/static
COPY --from=build --chown=root:root /build/public ./public
USER nonroot
EXPOSE 3000
CMD ["server.js"]
