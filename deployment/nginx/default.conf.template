# Per-app Nginx. TLS is terminated by the VPS gateway in front of this; the gateway's
# address range is trusted for the client IP (GATEWAY_CIDR), nothing else.
# ${GATEWAY_CIDR} is filled in at container start by the nginx image's envsubst step.

server_tokens off;
client_max_body_size 12m;
client_body_timeout 15s;
client_header_timeout 15s;
keepalive_timeout 30s;

set_real_ip_from ${GATEWAY_CIDR};
real_ip_header X-Forwarded-For;
real_ip_recursive on;

limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
limit_req_status 429;

upstream frontend { server frontend:3000; keepalive 8; }
upstream backend  { server backend:8000;  keepalive 8; }

server {
    listen 8080 default_server;
    server_name _;

    include /etc/nginx/snippets/security-headers.conf;

    # Never serve dotfiles or common leak paths.
    location ~ /\.(?!well-known/) { return 404; }

    location = /api/v1/auth/login {
        limit_req zone=login burst=5 nodelay;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }

    location /api/ {
        limit_req zone=api burst=40 nodelay;
        include /etc/nginx/snippets/security-headers.conf;
        # API responses (including file downloads) get one deny-all CSP, replacing
        # whatever the backend sent, so there's exactly one policy per response.
        add_header Content-Security-Policy "default-src 'none'; sandbox; frame-ancestors 'none'" always;
        proxy_hide_header Content-Security-Policy;
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;   # overwrite, never append client values
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID "";
        proxy_read_timeout 30s;
    }

    location / {
        proxy_pass http://frontend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
        # The frontend sets its own per-request nonce CSP.
    }
}
