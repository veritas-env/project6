# Copy to .env (never committed) and fill every value. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SLUG=projectflow
APP_NAME=ProjectFlow
APP_HTTP_PORT=18001            # 127.0.0.1 port the VPS TLS gateway proxies to
GATEWAY_CIDR=172.17.0.0/16     # address range of the TLS gateway (trusted for client IP)

APP_SECRET_KEY=
POSTGRES_SUPERUSER_PASSWORD=
DB_OWNER_PASSWORD=
DB_RW_PASSWORD=
REDIS_PASSWORD=

# Release images (pinned by digest at release time). Leave unset to build locally.
# BACKEND_IMAGE=ghcr.io/veritas-env/projectN-backend@sha256:...
# FRONTEND_IMAGE=ghcr.io/veritas-env/projectN-frontend@sha256:...
